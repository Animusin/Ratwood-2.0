// Authentic Ratwood world lore, pantheon, chain of command, and daily schedule helpers.

/proc/llm_get_ratwood_world_lore()
	var/list/l = list()
	l += "МИР И ЗЕМЛИ: Ты живёшь в суровом средневековом фэнтези-мире Ratwood (нынешний город/край: [SSmapping.current_map?.map_name || "город"]). Вокруг раскинулись опасные державы и земли: восточная империя Aavar (бояре, Железная Крепость дворфов, ядовитый лес Gloomwood), раздираемая гражданской войной Ferentia, древняя империя Grenzelhoft, теократия Otava, орды орков Gronn, морские налётчики Hammerhold, острова Etrusca и Kazengun, павший от демонов Naledi и мрачное подземье Underdark."
	l += "БОГИ И ВЕРА: В городах почитают Божественный Пантеон — прежде всего Psydon (свет, ортодоксия и инквизиция), а также Astrata, Eora, Dendor, Malum (кузнецы и ремесло), Ravox (закон и порядок), Necra, Noc, Pestra, Abyssor и Xylix (красота и наслаждение). Тёмных и нечеловеческих богов (Zizo — владыку нежити, Graggar — бога орочьих орд, Baotha, Matthios) боятся и считают ересью."
	l += "ВЛАСТЬ И ЦЕПОЧКА КОМАНДОВАНИЯ: Наверху стоит Лорд (Lord), его Консорт (Consort) и Наследник (Prince). Ниже — Десница (Hand), Управляющий (Steward), Судебный пристав (Bailiff) и Советники. Закон и меч держат Капитан (Captain / Watchcaptain), Сержанты, Надзиратель темницы (Warden) и Стража (Townguard / Garrison), а за верой и ересью следит Инквизиция и Церковь (Priest, Templar). Ниже стоят гильдмастера, купцы, трактирщики и ремесленники; в самом низу — крестьяне, прислуга, бродяги и узники."
	return jointext(l, "\n")

/proc/llm_describe_daily_schedule(tod_val, archetype_hint = "")
	var/la = llm_lower_ru(archetype_hint)
	var/is_guard = findtext(la, "страж") || findtext(la, "watch") || findtext(la, "гвард") || findtext(la, "капитан")

	switch(tod_val)
		if("dawn")
			if(is_guard)
				return "Рассвет: пора проснуться, одеться, перекусить, проверить снаряжение и выйти на обход улиц и ворот."
			return "Рассвет: пора проснуться, одеться, утолить голод и жажду, подышать воздухом и узнать утренние новости."
		if("day")
			if(is_guard)
				return "День: патрулирование площади, рынка и таверны, присмотр за порядком, проверка подозрительных лиц и доклады старшим."
			return "День: город кипит — пора пройтись по площади и рынку, поискать заработок, поторговаться, послушать сплетни или подкрепиться."
		if("dusk")
			if(is_guard)
				return "Сумерки: народ тянется в таверну, начинаются пьяные ссоры и кражи — держи ухо востро, можно заглянуть к очагу."
			return "Сумерки: самое время осесть в таверне или у тёплого очага, пропустить кружку эля, покурить, поболтать или пофлиртовать."
		if("night")
			if(is_guard)
				return "Ночь: опасное время, в переулках шастают воры и нежить. Патрулируй светлые улицы или отдохни в казарме, если смена тихая."
			return "Ночь: на улицах темно и опасно. Пора искать тёплую комнату или свободную кровать, раздеться и лечь спать до рассвета (или сидеть у огня в безопасности)."
		else
			return "Обычное время дня: живи своим чередом, следи за потребностями и окружением."
