/// Two combatants must not keep each other alive after both have been destroyed.
/datum/unit_test/animal_hostile_target_cleanup/Run()
	for(var/corpses in list(FALSE, TRUE))
		var/mob/living/simple_animal/hostile/first = new /mob/living/simple_animal/hostile/retaliate/rogue/wolf(run_loc_floor_bottom_left)
		var/mob/living/simple_animal/hostile/second = new /mob/living/simple_animal/hostile/retaliate/rogue/bigrat(run_loc_floor_bottom_left)
		set_mutual_targets(first, second, corpses)
		qdel(first)
		qdel(second)
		// Capture before field assertions, which can retain their receiver in a BYOND temporary.
		var/first_refs = refcount(first)
		var/second_refs = refcount(second)
		TEST_ASSERT(first_refs <= baseline_refs(), "The second combatant must release the destroyed wolf ([first_refs] references; baseline [baseline_refs()]).")
		TEST_ASSERT(second_refs <= baseline_refs(), "The first combatant must release the destroyed rat ([second_refs] references; baseline [baseline_refs()]).")
		TEST_ASSERT_NULL(first.target, "A destroyed hostile must release its combat target.")
		TEST_ASSERT_NULL(second.target, "Both sides of a combat target cycle must be released.")

/datum/unit_test/animal_hostile_target_cleanup/proc/set_mutual_targets(mob/living/simple_animal/hostile/first, mob/living/simple_animal/hostile/second, corpses)
	first.GiveTarget(second)
	second.GiveTarget(first)
	TEST_ASSERT_EQUAL(first.target, second, "Assigning the first combat target must still work.")
	TEST_ASSERT_EQUAL(second.target, first, "Assigning the second combat target must still work.")
	if(corpses)
		first.death()
		second.death()
		TEST_ASSERT(!QDELETED(first) && !QDELETED(second), "Ordinary animal death must still leave both corpses.")

/// Death and explicit loss of aggro retain their existing behavior; only destruction drops references.
/datum/unit_test/animal_hostile_target_lifecycle/Run()
	var/mob/living/simple_animal/hostile/animal = new /mob/living/simple_animal/hostile/retaliate/rogue/wolf(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/consistent/target = new(run_loc_floor_bottom_left)
	animal.GiveTarget(target)
	TEST_ASSERT_EQUAL(animal.target, target, "A living animal must keep its assigned target.")
	animal.LoseTarget()
	TEST_ASSERT_NULL(animal.target, "Explicit deaggro must still clear the target.")
	animal.GiveTarget(target)
	animal.death()
	TEST_ASSERT(!QDELETED(animal) && animal.stat == DEAD, "Death must leave a corpse rather than destroy the animal.")
	TEST_ASSERT_NULL(animal.target, "Ordinary death must still stop the corpse's combat targeting.")
	qdel(animal)
	TEST_ASSERT_NULL(animal.target, "Destroying the corpse must release its target.")
	TEST_ASSERT(!QDELETED(target), "Releasing an animal's target must not destroy the targeted character.")
	qdel(target)

/// Exercise the ordinary GC queue: weakref.resolve() alone would conceal a retained qdel'd mob.
/datum/unit_test/animal_hostile_target_native_gc/Run()
	var/list/identities = list()
	for(var/path in list(/mob/living/simple_animal/hostile/retaliate/rogue/wolf, /mob/living/simple_animal/hostile/retaliate/rogue/bigrat, /mob/living/simple_animal/hostile/retaliate/rogue/spider/rock))
		for(var/corpses in list(FALSE, TRUE))
			identities += create_deleted_pair(path, corpses)
	sleep(10 SECONDS)
	for(var/list/identity as anything in identities)
		TEST_ASSERT(!still_retained(identity), "A destroyed [identity["type"]] must collect without a hard delete after mutual combat targeting.")

/datum/unit_test/animal_hostile_target_native_gc/proc/create_deleted_pair(path, corpses)
	var/mob/living/simple_animal/hostile/first = new path(run_loc_floor_bottom_left)
	var/mob/living/simple_animal/hostile/second = new path(run_loc_floor_bottom_left)
	first.GiveTarget(second)
	second.GiveTarget(first)
	if(corpses)
		first.death()
		second.death()
	var/list/first_identity = list("reference" = text_ref(first), "type" = first.type)
	var/list/second_identity = list("reference" = text_ref(second), "type" = second.type)
	qdel(first)
	qdel(second)
	first_identity["gc_destroyed"] = first.gc_destroyed
	second_identity["gc_destroyed"] = second.gc_destroyed
	return list(first_identity, second_identity)

/datum/unit_test/animal_hostile_target_native_gc/proc/still_retained(list/identity)
	var/datum/candidate = locate(identity["reference"])
	return candidate && candidate.type == identity["type"] && candidate.gc_destroyed == identity["gc_destroyed"]
