/// Frequent unobserved footsteps must not allocate quarry images or filters, including in-place refreshes.
/datum/unit_test/runtime_track_lazy_highlights/Run()
	allocate(/datum/performance_track_pool_fixture)
	var/mob/living/creator = allocate(/mob/living)
	var/mob/living/carbon/human/consistent/investigator = allocate(/mob/living/carbon/human/consistent)
	var/obj/effect/track/track = creator.create_ordinary_track(run_loc_floor_bottom_left)
	var/track_atoms_created = SStracks.tracks_created
	var/highlights_created = 0
	for(var/i in 1 to 100)
		creator.dir = (i % 2) ? EAST : WEST
		TEST_ASSERT_EQUAL(creator.create_ordinary_track(run_loc_floor_bottom_left), track, "The repeated-footstep workload must reuse one atom.")
		TEST_ASSERT_EQUAL(track.get_track_image(investigator), track.real_image, "Ordinary investigators must still receive the ordinary footprint image.")
		TEST_ASSERT_EQUAL(track.real_image.dir, creator.dir, "A refreshed ordinary footprint must retain the passerby's current direction.")
		if(track.marked_image)
			highlights_created++
	TEST_ASSERT_EQUAL(highlights_created, 0, "One hundred ordinary footsteps must allocate no unused quarry highlights (previously one per refresh).")
	TEST_ASSERT_EQUAL(SStracks.tracks_created, track_atoms_created, "Lazy highlights must preserve in-place footprint reuse.")
	TEST_ASSERT_EQUAL(track.expiry_time, world.time + 20 MINUTES, "The allocation optimization must preserve footprint lifetime.")

/// Known quarry tracks retain their direction, private selection and shared image until their trace is replaced.
/datum/unit_test/runtime_track_known_quarry_highlights/Run()
	allocate(/datum/performance_track_pool_fixture)
	var/mob/living/creator = allocate(/mob/living)
	var/mob/living/other_creator = allocate(/mob/living)
	var/mob/living/carbon/human/consistent/first = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/consistent/second = allocate(/mob/living/carbon/human/consistent)
	creator.dir = EAST
	var/obj/effect/track/track = creator.create_ordinary_track(run_loc_floor_bottom_left, TRUE)
	TEST_ASSERT(!track.check_reveal(first), "A quarry-only trace must remain hidden from an unrelated investigator.")
	first.set_tracking_mark(creator)
	second.set_tracking_mark(creator)
	TEST_ASSERT(track.check_reveal(first), "Marking its owner must still allow the investigator to discover a quarry-only trace.")
	track.add_knower(first)
	track.add_knower(second)
	TEST_ASSERT_NULL(track.marked_image, "Remembering a trace without a connected viewer must not allocate its highlight.")
	var/image/highlight = track.get_track_image(first)
	TEST_ASSERT(highlight && highlight != track.real_image, "A quarry viewer must receive a distinct highlighted image.")
	TEST_ASSERT_EQUAL(highlight.icon_state, "tracks_marked", "The lazily created highlight must use the quarry sprite.")
	TEST_ASSERT_EQUAL(highlight.dir, EAST, "The quarry highlight must preserve the original footprint direction.")
	TEST_ASSERT_EQUAL(length(highlight.filters), 1, "The quarry highlight must have exactly one outline filter.")
	for(var/i in 1 to 100)
		TEST_ASSERT_EQUAL(track.get_track_image(second), highlight, "Repeated views and other investigators must reuse the same highlight.")
	TEST_ASSERT_EQUAL(length(highlight.filters), 1, "Repeated views must not accumulate outline filters.")
	first.set_tracking_mark(null)
	TEST_ASSERT_EQUAL(track.get_track_image(first), track.real_image, "Dropping a quarry must return the ordinary image for that viewer.")
	TEST_ASSERT_EQUAL(track.get_track_image(second), highlight, "Dropping one investigator's quarry must preserve another's highlight.")
	other_creator.dir = WEST
	TEST_ASSERT_EQUAL(other_creator.create_ordinary_track(run_loc_floor_bottom_left), track, "Replacing evidence must still reuse the atom.")
	TEST_ASSERT_NULL(track.marked_image, "Replacing evidence must discard the previous quarry highlight.")
	TEST_ASSERT_EQUAL(length(track.known_by), 0, "Replacing evidence must discard previous investigators' knowledge.")
	second.set_tracking_mark(other_creator)
	track.add_knower(second)
	var/image/new_highlight = track.get_track_image(second)
	TEST_ASSERT(new_highlight != highlight, "A replacement trace must not inherit the previous trace's image.")
	TEST_ASSERT_EQUAL(new_highlight.dir, WEST, "A newly marked replacement must display the new direction.")
	var/obj/effect/track/structure/clue = allocate(/obj/effect/track/structure)
	clue.handle_creation(other_creator)
	TEST_ASSERT_EQUAL(clue.get_track_image(second), clue.real_image, "Structure clues must keep their own image when their owner is a quarry.")
	TEST_ASSERT_NULL(clue.marked_image, "Structure clues must not allocate an ordinary footprint highlight.")
