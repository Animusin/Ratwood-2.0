/// Silver utensils can hit cursed armor without being eligible for weapon blessings.
/datum/unit_test/runtime_nov07_silver_armor_damage/Run()
	var/mob/living/carbon/human/consistent/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/suit/roguetown/armor/chainmail/ancient/armor = allocate(/obj/item/clothing/suit/roguetown/armor/chainmail/ancient)
	wearer.equip_to_slot(armor, SLOT_ARMOR)
	TEST_ASSERT_EQUAL(wearer.get_best_worn_armor(BODY_ZONE_CHEST, "slash"), armor, "The real ancient mail must protect the targeted zone.")
	var/obj/item/kitchen/fork/silver/fork = allocate(/obj/item/kitchen/fork/silver)
	TEST_ASSERT(fork.is_silver, "The ordinary silver fork must use the silver damage path.")
	TEST_ASSERT_NULL(fork.GetComponent(/datum/component/silverbless), "Silver utensils must not require a weapon-only blessing component.")
	var/obj/item/rogueweapon/huntingknife/idagger/silver/dagger = allocate(/obj/item/rogueweapon/huntingknife/idagger/silver)
	var/datum/component/silverbless/blessing = dagger.GetComponent(/datum/component/silverbless)
	TEST_ASSERT_NOTNULL(blessing, "The normal silver dagger must retain its blessing component.")
	TEST_ASSERT(!blessing.is_blessed, "The normal silver dagger must start unblessed.")
	var/obj/item/rogueweapon/huntingknife/idagger/silver/stake/preblessed/tenn = allocate(/obj/item/rogueweapon/huntingknife/idagger/silver/stake/preblessed)
	var/obj/item/rogueweapon/huntingknife/idagger/silver/stake/preblessed/psy/psydon = allocate(/obj/item/rogueweapon/huntingknife/idagger/silver/stake/preblessed/psy)
	var/list/weapons = list(fork, dagger, tenn, psydon)
	var/list/expected_damage = list(20, 20, 22, 26)
	var/runtimes_before = GLOB.total_runtimes
	for(var/index in 1 to length(weapons))
		armor.obj_integrity = armor.max_integrity
		var/protection = wearer.checkarmor(BODY_ZONE_CHEST, "slash", 20, used_weapon = weapons[index])
		TEST_ASSERT(protection > 0, "A silver hit must still return the worn armor's protection.")
		TEST_ASSERT_EQUAL(armor.max_integrity - armor.obj_integrity, expected_damage[index], "Silver must deal normal armor damage unless its actual blessing grants a bonus.")
	TEST_ASSERT_EQUAL(GLOB.total_runtimes, runtimes_before, "Unblessable silver items and both weapon blessings must finish armor processing without runtimes.")
